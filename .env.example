# ---- World ID 4 (developer.world.org) ----
# Leave empty to run the built-in demo simulator.
NEXT_PUBLIC_WLD_APP_ID=app_xxxxxxxxxxxxxxxx
WLD_RP_ID=rp_xxxxxxxxxxxxxxxx
WLD_RP_SIGNING_KEY=              # hex, server-only. Never expose.
# staging = test with https://simulator.worldcoin.org/
NEXT_PUBLIC_WLD_ENV=staging
# Action created in the Developer Portal. Set "max verifications" to unlimited:
# the same human proves ownership on every fresh approval.
NEXT_PUBLIC_WLD_ACTION=hen-owner

# ---- Monid (app.monid.ai/access/api-keys) ----
MONID_API_KEY=monid_live_xxx
# MONID_API_BASE_URL=https://api.monid.ai

# ---- Optional: Claude for capsule extraction (falls back to local rules) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
